<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <block type="trade_definition" id="LDP^trade_definition" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="LDP^market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">jump_index</field>
        <field name="SYMBOL_LIST">JD10</field>
        <next>
          <block type="trade_definition_tradetype" id="LDP^tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="LDP^contract" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="LDP^interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="LDP^restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="LDP^restarterror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="LDP^options">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="LDP^duration"><field name="NUM">3</field></shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="LDP^amount"><field name="NUM">1</field></shadow>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="LDP^prediction" inline="true"><field name="NUM">7</field></shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="LDP^during" x="714" y="60">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="LDP^sellsif">
        <value name="IF0">
          <block type="check_sell" id="LDP^sells"></block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="LDP^after" x="714" y="292">
    <statement name="AFTERPURCHASE_STACK">
      <block type="tick_delay" id="LDP^tickdelay">
        <statement name="TICKDELAYSTACK">
          <block type="controls_if" id="LDP^ifwin">
            <value name="IF0">
              <block type="contract_check_result" id="LDP^reswin"><field name="CHECK_RESULT">win</field></block>
            </value>
            <statement name="DO0">
              <block type="trade_again" id="LDP^again"></block>
            </statement>
          </block>
        </statement>
        <value name="TICKDELAYVALUE">
          <block type="math_number" id="LDP^ticks"><field name="NUM">11</field></block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="LDP^before" deletable="false" x="0" y="658">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="LDP^gate">
        <value name="IF0">
          <block type="logic_compare" id="LDP^cmp">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="last_digit" id="LDP^lastdigit"></block>
            </value>
            <value name="B">
              <block type="math_number" id="LDP^target"><field name="NUM">7</field></block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="LDP^purchase"><field name="PURCHASE_LIST">DIGITDIFF</field></block>
        </statement>
      </block>
    </statement>
  </block>
</xml>